# Time with Jon: environment variables (names only, NO values).
# Real values live in Vercel env vars (per project) and the maintainer's private secret store, never in git.
# Every variable here is validated by src/config/env.ts; tests/unit/env.test.ts keeps the two in sync.
#
# "Required in: all" means every APP_MODE. "real adapters" means staging and production only;
# prototype and PR previews use the mock adapters (AD-6, T1.10).

# ── App ─────────────────────────────────────────────────────────────────────
# prototype | staging | production. /dev/* routes are built ONLY when prototype (AD-13).
APP_MODE=
# Public origin, no trailing slash. Used for links in emails and the Origin check on non-GETs (AD-7).
# prototype: https://timewithjon-proto.vercel.app · staging: https://staging.timewithjon.com
# production: https://timewithjon.com
NEXT_PUBLIC_SITE_URL=
# Comma-separated admin allowlist. Exactly Jon's Gmail (AD-7). Required in: all
ADMIN_EMAILS=
# HMAC key for the signed twj_invite cookie and the twj_req request capability (C2). 32+ random bytes, base64.
# Required in: all.
SESSION_SIGNING_SECRET=

# ── Supabase (AD-3, AD-4, AD-7) ────────────────────────────────────────────
SUPABASE_URL=
# The project's PUBLISHABLE key (sb_publishable_...; Supabase's replacement for the legacy anon JWT).
SUPABASE_ANON_KEY=
# The project's SECRET key (sb_secret_...; replaces the legacy service_role JWT). Server only. Storage signed
# URLs and Auth admin calls. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# App database access via `pg` over the Supavisor TRANSACTION pooler (port 6543), with no ?sslmode= (see DATABASE_SSL). Required in: all
DATABASE_URL=
# Session/direct connection for Supabase CLI migrations only; the app never reads it.
DIRECT_URL=
# TLS to Postgres (M11): verify-full (default) checks the server certificate against DATABASE_CA_CERT.
# disable = no TLS, allowed ONLY for a loopback host (local test DB). Required in: all (defaults to verify-full)
DATABASE_SSL=
# PEM of the Supabase root CA (Dashboard -> Database -> SSL -> Download certificate). Not secret.
# Required when DATABASE_SSL=verify-full.
DATABASE_CA_CERT=

# ── Scheduled jobs (AD-8) ──────────────────────────────────────────────────
# Sent by pg_cron/pg_net as the x-cron-secret header to /api/cron/tick and /api/jobs/media.
# Required in: all.
CRON_SECRET=
# Passphrase for the /dev/outbox, /dev/state and /dev/tick tools (prototype builds only, AD-13).
# Required in: prototype.
DEV_PASSPHRASE=
# Set automatically by Vercel on every deployment ("1"). Never set it yourself: it makes the app trust
# X-Forwarded-For as the client IP for rate limits (only Vercel's edge overwrites that header).
VERCEL=
# "1" turns on admin sign-in and every /api/admin/** route (M2, behind a flag per the TSD waiver). Unset = 404.
# Turn it on only after the signin_count migration is pushed to that project.
FEATURE_ADMIN_AUTH=

# ── Email (AD-5, TSD v1.5) ──────────────────────────────────────────────────
# Outbound: Resend FREE in production only, behind the daily-budget guard (T3.2).
# Staging (and the production fallback) send through the Gmail API mailer (T3.17), which reuses the
# Google OAuth client below. Inbound jon@/stories@/admin@ is Cloudflare Email Routing to Jon's Gmail:
# no inbound webhook, nothing inbound reaches the app. Admin sign-in codes go via Supabase SMTP (AD-7).
# Required in: production.
RESEND_API_KEY=
# Optional. Svix signing secret for the bounce/complaint webhook (email.bounced, email.complained), only
# if the Free plan allows an endpoint (checked in T3.1); otherwise the tick polls GET /emails/{id}.
RESEND_WEBHOOK_SECRET=
# Optional. A Resend key with read access (GET /emails/{id}), for bounce polling only when there is no
# webhook. Without it, polling is off (the production send key is sending-only).
RESEND_READ_KEY=
# Required in: production. Guest-facing From, "Jon <jon@timewithjon.com>"
EMAIL_FROM_GUEST=
# Required in: production. Jon-facing From, "Time with Jon <admin@timewithjon.com>"
EMAIL_FROM_ADMIN=
# Required in: real adapters. Jon's Gmail: Reply-To on every email (staging: the test Gmail).
JON_PERSONAL_EMAIL=

# ── Google OAuth: Calendar (AD-6) and the Gmail API mailer (T3.17) ──────────
# Required in: real adapters. Production: timewithjon-google-oauth · staging: timewithjon-staging-google-oauth
# (staging = its own GCP project 'twj-staging', the test Gmail, Testing mode; never the twj-t06-spike project).
# Staging's granted scopes = exactly openid, userinfo.email, calendar.app.created, calendar.freebusy, gmail.send.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# AES-256-GCM key (32 bytes, base64) for the stored refresh token (the-wip pattern).
GOOGLE_TOKEN_ENC_KEY=
# Optional. Key rotation only: the OLD key, kept until the stored token has been re-encrypted under the new one.
GOOGLE_TOKEN_ENC_KEY_PREVIOUS=
# Optional. '1' = the connect also asks for gmail.send (the T3.17 Gmail API mailer). Staging: 1. Production: unset
# until the AD-5 fallback flip, then Jon reconnects once. Unset = exactly the four G3 scopes.
GOOGLE_GMAIL_SEND=

# ── Cloudflare Turnstile (AD-9) ─────────────────────────────────────────────
# Required in: real adapters.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cloudflare R2: write-through photo backup (AD-4) ────────────────────────
# Required in: real adapters. (an R2 API token: account id, access key id, secret access key, bucket name)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=

# ── Sentry (AD-11) ──────────────────────────────────────────────────────────
# Optional locally; set on every Vercel project.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (source-map upload). Not read at runtime.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
