{
  "name": "timewithjon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Time with Jon: invite-only booking site for Jon Cartwright's 50th (Next.js App Router + Supabase).",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-real-photos.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run -c vitest.int.config.ts",
    "test:engine:tz": "TZ=UTC vitest run src/lib src/features/availability && TZ=Europe/London vitest run src/lib src/features/availability && TZ=America/Vancouver vitest run src/lib src/features/availability",
    "db:test": "scripts/test-db.sh up",
    "test:route": "scripts/test-route.sh",
    "test:e2e": "tests/e2e/run.sh smoke",
    "test:e2e:full": "tests/e2e/run.sh full"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^11.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "archiver": "8.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "heic-decode": "2.1.0",
    "next": "16.3.7",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/archiver": "8.0.0",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
